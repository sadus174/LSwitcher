# Publish only application source, tests, required resources and README.
/*
!/.gitignore
!/README.md
!/CHANGELOG.md
!/Package.swift
!/Sources/
!/Resources/
!/Tests/
!/openspec/
!/.agents/
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/openspec-*/

# Credentials, private maintenance tools and build output must never be committed.
/keys/
!/scripts/
/scripts/*
!/scripts/build-dmg.sh
!/scripts/release-preflight.sh
!/scripts/sign-update.swift
!/scripts/check-size.py
!/scripts/test-updater.py
!/scripts/test-release-workflow.py
!/RELEASING.md
/.build/
/.upstream/
/dist/
/benchmarks/
.DS_Store
Resources/IconPreview.png
Resources/AppIcon.iconset/
